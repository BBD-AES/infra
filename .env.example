DOCKERHUB_USERNAME=inwoohwang

# 콘솔(React) nginx 공개 포트. 게이트웨이가 redirect 를 localhost:5173 으로 하드코딩하므로 5173 권장.
# 이미지 태그(CONSOLE_TAG)는 배포 워크플로가 dispatch 페이로드에서 주입 — 여기 둘 필요 없음(미지정 시 latest).
CONSOLE_PORT=5173

